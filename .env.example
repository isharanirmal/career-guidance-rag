# Server
APP_ENV=development
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
ALLOWED_HOSTS=127.0.0.1,localhost

# AI providers - configure ONE or MORE. The app skips empty keys.
# Preferred order is controlled by LLM_FALLBACK_ORDER.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional alias for Anthropic/Claude
CLAUDE_API_KEY=

# auto = use configured providers in fallback order
LLM_PROVIDER=auto
LLM_FALLBACK_ORDER=openai,anthropic,gemini,groq

# Models (change if your account uses a different available model)
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=openai/gpt-oss-120b

# Live/current public information. Google Search grounding is available when Gemini is configured.
WEB_SEARCH_ENABLED=true

# Upload/security limits
MAX_UPLOAD_MB=5
MAX_PDF_PAGES=15
MAX_TEXT_CHARS=30000

# Simple in-memory rate limit (per client IP)
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# Authentication / security
# Set true only when serving the app over HTTPS.
COOKIE_SECURE=false
SESSION_TTL_SECONDS=28800
PBKDF2_ITERATIONS=310000
AUTH_DB_PATH=data/careerguide_auth.db
MAX_IMAGE_MB=3
